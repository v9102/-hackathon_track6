# Environment variables for Resume Tailoring System
# Copy this file to .env and fill in your values

# Base directory for data/storage/resumes. Defaults to the repo root when
# detected, or the current working directory for installed copies.
RESUME_AGENT_BASE_DIR=

# Tavily API Key (for role research)
TAVILY_API_KEY=

# OpenAI API Key (optional, for LLM features)
OPENAI_API_KEY=

# Streamlit server port
PORT=8501